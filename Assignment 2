#include <iostream>
#include <string>
using namespace std;

class Student
{
public:
    string name;
    int age;
    string course;

    void show()
    {
        cout << "Student Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Course: " << course << endl;
    }
};

int main()
{
    Student s;

    s.name = "Aditi";
    s.age = 18;
    s.course = "B.Tech AIML";

    s.show();

    return 0;
}