#include <iostream>
#include <string>
using namespace std;

class Student
{
public:
    string name;
    int age;
    string course;

    void setDetails(string name, int age, string course)
    {
        this->name = name;
        this->age = age;
        this->course = course;
    }

    void display()
    {
        cout << "Student Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Course: " << course << endl;
    }
};

int main()
{
    Student s;

    s.setDetails("Aditi", 18, "AIML");

    s.display();

    return 0;
}